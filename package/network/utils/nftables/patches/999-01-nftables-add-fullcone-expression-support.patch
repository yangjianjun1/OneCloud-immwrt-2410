From e5660fb4ab44d902810c7f6681789f017556498a Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Sat, 9 Apr 2022 00:38:51 +0800
Subject: [PATCH] nftables: add fullcone expression support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 include/linux/netfilter/nf_tables.h | 16 ++++++++++++++++
 include/statement.h                 |  1 +
 src/netlink_delinearize.c           | 48 +++++++++++++++++++++++++++++++++++++++
 src/netlink_linearize.c             | 34 +++++++++++++++++++++++++++
 src/parser_bison.y                  |  9 +++++++
 src/scanner.l                       |  1 +
 src/statement.c                     |  1 +
 7 files changed, 110 insertions(+)

diff --git a/include/linux/netfilter/nf_tables.h b/include/linux/netfilter/nf_tables.h
index 1871c10..2b42628 100644
--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1556,6 +1556,22 @@ enum nft_expressions {
	NFT_EXPR_XOR,
	NFT_EXPR_MP,
	NFT_EXPR_FLOW_OFFLOAD,
+	NFT_EXPR_FULLCONE,
+	NFT_EXPR_RCONE,
+	NFT_EXPR_PRCONE,
+};
+
+/**
+ * enum nft_fullcone_attributes - nftables fullcone expression
+ *
+ * @NFTA_FULLCONE_UNSPEC: unspecified
+ * @NFTA_FULLCONE_TYPE: NAT type (u32)
+ */
+enum nft_fullcone_attributes {
+	NFTA_FULLCONE_UNSPEC,
+	NFTA_FULLCONE_TYPE,
+	__NFTA_FULLCONE_MAX
+};
+#define NFTA_FULLCONE_MAX	(__NFTA_FULLCONE_MAX - 1)
+
+enum nft_nat_type {
+	NFT_NAT_FULLCONE,
+	NFT_NAT_RCONE,
+	NFT_NAT_PRCONE,
 };

 /**
  * enum nft_range_attributes - range expression
diff --git a/include/statement.h b/include/statement.h
index 279c348..4122440 100644
--- a/include/statement.h
+++ b/include/statement.h
@@ -244,6 +244,7 @@ enum stmt_type {
	STMT_XOR,
	STMT_MP,
	STMT_FLOW_OFFLOAD,
+	STMT_FULLCONE,
	STMT_OBJREF,
	STMT_COUNTER,
	STMT_QUOTA,
diff --git a/src/netlink_delinearize.c b/src/netlink_delinearize.c
index 8808470..a201097 100644
--- a/src/netlink_delinearize.c
+++ b/src/netlink_delinearize.c
@@ -1766,6 +1766,54 @@ static int netlink_delinearize_expr(struct nftnl_expr *nle, struct expr **res)
		break;
	}

+	case NFT_EXPR_FULLCONE: {
+		struct expr *expr;
+		uint32_t type;
+
+		if (nftnl_expr_get_u32(nle, NFTA_FULLCONE_TYPE, &type) < 0)
+			return -1;
+
+		expr = expr_alloc(EXPR_STATEMENT);
+		expr->stmt.stmt = stmt_alloc(STMT_FULLCONE);
+
+		switch(type) {
+		case NFT_NAT_FULLCONE:
+			expr->stmt.fullcone_type = "fullcone";
+			break;
+		case NFT_NAT_RCONE:
+			expr->stmt.fullcone_type = "rcone";
+			break;
+		case NFT_NAT_PRCONE:
+			expr->stmt.fullcone_type = "prcone";
+			break;
+		default:
+			return -1;
+		}
+		*res = expr;
+		break;
+	}
+
	default:
		return -1;
	}
	return 0;
diff --git a/src/netlink_linearize.c b/src/netlink_linearize.c
index 2323471..2842435 100644
--- a/src/netlink_linearize.c
+++ b/src/netlink_linearize.c
@@ -1514,6 +1514,40 @@ static int netlink_linearize_expr(struct netlink_ctx *ctx, const struct expr *e)
		break;
	}

+	case STMT_FULLCONE: {
+		struct nftnl_expr *nle;
+		uint32_t nat_type;
+
+		nle = nftnl_expr_alloc("fullcone");
+		if (!nle)
+			return -1;
+
+		if (!strcmp(e->stmt.fullcone_type, "fullcone"))
+			nat_type = NFT_NAT_FULLCONE;
+		else if (!strcmp(e->stmt.fullcone_type, "rcone"))
+			nat_type = NFT_NAT_RCONE;
+		else if (!strcmp(e->stmt.fullcone_type, "prcone"))
+			nat_type = NFT_NAT_PRCONE;
+		else
+			return -1;
+
+		nftnl_expr_set_u32(nle, NFTA_FULLCONE_TYPE, nat_type);
+
+		if (netlink_linearize_add_expr(ctx, nle) < 0) {
+			nftnl_expr_free(nle);
+			return -1;
+		}
+		break;
+	}
+
	default:
		return -1;
	}
	return 0;
diff --git a/src/parser_bison.y b/src/parser_bison.y
index 748b338..00d2450 100644
--- a/src/parser_bison.y
+++ b/src/parser_bison.y
@@ -1621,6 +1621,15 @@ stmt:
		$$ = expr;
	}
|
+	FULLCONE
+	{
+		struct expr *expr;
+
+		expr = expr_alloc(EXPR_STATEMENT);
+		expr->stmt.stmt = stmt_alloc(STMT_FULLCONE);
+		expr->stmt.fullcone_type = "fullcone";
+		$$ = expr;
+	}
|
	OBJREF		{ $$ = objref_expr($1); }
|
	COUNTER		{ $$ = counter_expr($1); }
diff --git a/src/scanner.l b/src/scanner.l
index 7071234..1442248 100644
--- a/src/scanner.l
+++ b/src/scanner.l
@@ -653,6 +653,7 @@ xor		{ return XOR; }
 mp		{ return MP; }
 flow		{ return FLOW; }
 offload	{ return OFFLOAD; }
+fullcone	{ return FULLCONE; }
 objref		{ return OBJREF; }
 counter	{ return COUNTER; }
 quota		{ return QUOTA; }
diff --git a/src/statement.c b/src/statement.c
index 4342704..740b268 100644
--- a/src/statement.c
+++ b/src/statement.c
@@ -214,6 +214,7 @@ static const char *stmt_names[] = {
	[STMT_XOR]		= "xor",
	[STMT_MP]		= "mp",
	[STMT_FLOW_OFFLOAD]	= "flow_offload",
+	[STMT_FULLCONE]		= "fullcone",
	[STMT_OBJREF]		= "objref",
	[STMT_COUNTER]		= "counter",
	[STMT_QUOTA]		= "quota",
--
2.45.1
