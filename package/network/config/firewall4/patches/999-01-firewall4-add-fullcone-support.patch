From 66084476408441182187140d3017748220412744 Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Sat, 9 Apr 2022 00:42:17 +0800
Subject: [PATCH] firewall4: add fullcone nat support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 root/etc/config/firewall        |  2 ++
 root/usr/share/firewall4/main.nft | 12 ++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/root/etc/config/firewall b/root/etc/config/firewall
index 54b7224..b282268 100644
--- a/root/etc/config/firewall
+++ b/root/etc/config/firewall
@@ -34,6 +34,8 @@ config zone
        option network 'wan'
        option input 'REJECT'
        option output 'ACCEPT'
+       option fullcone '0'
+
        option forward 'REJECT'
        option masq '1'
        option mtu_fix '1'
diff --git a/root/usr/share/firewall4/main.nft b/root/usr/share/firewall4/main.nft
index 1201871..f308500 100644
--- a/root/usr/share/firewall4/main.nft
+++ b/root/usr/share/firewall4/main.nft
@@ -448,6 +448,18 @@ table inet fw4 {
                        masquerade
                }

+               {% if zone.fullcone | default(0) == 1 %}
+               ip protocol udp fullcone
+               {% endif %}
+
        }

        chain dstnat_wan {
--
2.35.1
