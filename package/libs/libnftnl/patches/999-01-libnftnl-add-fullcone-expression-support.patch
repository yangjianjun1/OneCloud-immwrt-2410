From 692bdcc207b3989ce39cbc74fc5c74aa15359ff0 Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Fri, 8 Apr 2022 23:52:11 +0800
Subject: [PATCH] libnftnl: add fullcone expression support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 include/libnftnl/expr.h | 6 ++++++
 src/expr_ops.c          | 1 +
 src/expr/fullcone.c     | 64 +++++++++++++++++++++++++++++++++++++++++++++++++
 src/Makefile.am         | 1 +
 4 files changed, 72 insertions(+)
 create mode 100644 src/expr/fullcone.c

diff --git a/include/libnftnl/expr.h b/include/libnftnl/expr.h
index 985113b..4443838 100644
--- a/include/libnftnl/expr.h
+++ b/include/libnftnl/expr.h
@@ -271,6 +271,12 @@ enum {
        NFTNL_EXPR_TUNNEL_ID,
 };

+enum {
+       NFTNL_EXPR_FULLCONE_NONE,
+       NFTNL_EXPR_FULLCONE,
+       NFTNL_EXPR_FULLCONE_MAX
+};
+
 enum nftnl_expr_type {
        NFTNL_EXPR_UNKNOWN,
        NFTNL_EXPR_IMMEDIATE,
@@ -347,6 +353,7 @@ enum nftnl_expr_type {
        NFTNL_EXPR_TUNNEL,
        NFTNL_EXPR_TUNNEL_KEY,
        NFTNL_EXPR_VLAN,
+       NFTNL_EXPR_FULLCONE,
        __NFTNL_EXPR_MAX
 };

diff --git a/src/expr_ops.c b/src/expr_ops.c
index 4660047..3110680 100644
--- a/src/expr_ops.c
+++ b/src/expr_ops.c
@@ -50,6 +50,7 @@ extern struct expr_ops expr_ops_tunnel;
 extern struct expr_ops expr_ops_tunnel_key;
 extern struct expr_ops expr_ops_vlan;
 extern struct expr_ops expr_ops_xfrm;
+extern struct expr_ops expr_ops_fullcone;

 static const struct expr_ops *expr_ops[] = {
        [NFTNL_EXPR_UNKNOWN] = &expr_ops_unknown,
@@ -100,6 +101,7 @@ static const struct expr_ops *expr_ops[] = {
        [NFTNL_EXPR_TUNNEL] = &expr_ops_tunnel,
        [NFTNL_EXPR_TUNNEL_KEY] = &expr_ops_tunnel_key,
        [NFTNL_EXPR_VLAN] = &expr_ops_vlan,
+       [NFTNL_EXPR_FULLCONE] = &expr_ops_fullcone,
 };

 const struct expr_ops *nftnl_expr_ops_get(uint32_t type)
diff --git a/src/expr/fullcone.c b/src/expr/fullcone.c
new file mode 100644
index 0000000..2708845
--- /dev/null
+++ b/src/expr/fullcone.c
@@ -0,0 +1,64 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libnftnl/expr.h>
+#include <libnftnl/rule.h>
+#include <linux/netfilter/nf_tables.h>
+
+static int nftnl_expr_fullcone_set(struct nftnl_expr *e, uint16_t type,
+                                  const void *data, uint32_t data_len)
+{
+       return 0;
+}
+
+static const void *nftnl_expr_fullcone_get(const struct nftnl_expr *e, uint16_t type,
+                                          uint32_t *data_len)
+{
+       *data_len = 0;
+       return NULL;
+}
+
+static int nftnl_expr_fullcone_parse(struct nftnl_expr *e, struct nlattr *attr)
+{
+       return 0;
+}
+
+static int nftnl_expr_fullcone_build(struct nlmsghdr *nlh, const struct nftnl_expr *e)
+{
+       return nla_put_u32(nlh, NFTA_EXPR_TYPE, NFT_EXPR_FULLCONE);
+}
+
+static int nftnl_expr_fullcone_json_parse(struct nftnl_expr *e, json_t *root,
+                                         struct nftnl_parse_err *err)
+{
+       return 0;
+}
+
+static json_t *nftnl_expr_fullcone_json(const struct nftnl_expr *e)
+{
+       return json_string("fullcone");
+}
+
+static int nftnl_expr_fullcone_export(const struct nftnl_expr *e, char *buf, size_t size,
+                                    uint32_t type, uint32_t flags)
+{
+       return snprintf(buf, size, "fullcone");
+}
+
+struct expr_ops expr_ops_fullcone = {
+       .name           = "fullcone",
+       .type           = NFTNL_EXPR_FULLCONE,
+       .set            = nftnl_expr_fullcone_set,
+       .get            = nftnl_expr_fullcone_get,
+       .parse          = nftnl_expr_fullcone_parse,
+       .build          = nftnl_expr_fullcone_build,
+       .json_parse     = nftnl_expr_fullcone_json_parse,
+       .json           = nftnl_expr_fullcone_json,
+       .export         = nftnl_expr_fullcone_export,
+};
diff --git a/src/Makefile.am b/src/Makefile.am
index 1524950..0821885 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -100,6 +100,7 @@ libnftnl_la_SOURCES += expr/tunnel-key.c
 libnftnl_la_SOURCES += expr/vlan.c
 libnftnl_la_SOURCES += expr/xfrm.c
 libnftnl_la_SOURCES += expr/ct.c
+libnftnl_la_SOURCES += expr/fullcone.c

 include_HEADERS += include/libnftnl/expr.h
 include_HEADERS += include/libnftnl/rule.h
--
2.35.1
