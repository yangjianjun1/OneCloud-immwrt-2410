From e5660fb4ab44d902810c7f6681789f017556498a Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Sat, 9 Apr 2022 00:38:51 +0800
Subject: [PATCH] libnftnl: add fullcone expression support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 include/libnftnl/expr.h       |  1 +
 include/linux/netfilter/nf_tables.h | 16 ++++++++++++++++
 src/expr/Makefile.am          |  1 +
 src/expr/fullcone.c           | 47 +++++++++++++++++++++++++++++++++++++++++++
 src/expr/expr_ops.c           |  1 +
 5 files changed, 66 insertions(+)
 create mode 100644 src/expr/fullcone.c

diff --git a/include/libnftnl/expr.h b/include/libnftnl/expr.h
index 42c5870..3208704 100644
--- a/include/libnftnl/expr.h
+++ b/include/libnftnl/expr.h
@@ -344,6 +344,7 @@ enum nftnl_expr_type {
	NFTNL_EXPR_FLOW_OFFLOAD,
	NFTNL_EXPR_XOR,
	NFTNL_EXPR_MP,
+	NFTNL_EXPR_FULLCONE,
	__NFTNL_EXPR_MAX
 };

diff --git a/include/linux/netfilter/nf_tables.h b/include/linux/netfilter/nf_tables.h
index 1871c10..2b42628 100644
--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1556,6 +1556,22 @@ enum nft_expressions {
	NFT_EXPR_XOR,
	NFT_EXPR_MP,
	NFT_EXPR_FLOW_OFFLOAD,
+	NFT_EXPR_FULLCONE,
+	NFT_EXPR_RCONE,
+	NFT_EXPR_PRCONE,
+};
+
+/**
+ * enum nft_fullcone_attributes - nftables fullcone expression
+ *
+ * @NFTA_FULLCONE_UNSPEC: unspecified
+ * @NFTA_FULLCONE_TYPE: NAT type (u32)
+ */
+enum nft_fullcone_attributes {
+	NFTA_FULLCONE_UNSPEC,
+	NFTA_FULLCONE_TYPE,
+	__NFTA_FULLCONE_MAX
+};
+#define NFTA_FULLCONE_MAX	(__NFTA_FULLCONE_MAX - 1)
+
+enum nft_nat_type {
+	NFT_NAT_FULLCONE,
+	NFT_NAT_RCONE,
+	NFT_NAT_PRCONE,
 };

 /**
  * enum nft_range_attributes - range expression
diff --git a/src/expr/Makefile.am b/src/expr/Makefile.am
index 2d34477..440079c 100644
--- a/src/expr/Makefile.am
+++ b/src/expr/Makefile.am
@@ -72,6 +72,7 @@ libnftnl_expr_la_SOURCES += \
	expr_xor.c \
	expr_mp.c \
	expr_flow_offload.c \
+	expr_fullcone.c \
	expr_objref.c \
	expr_counter.c \
	expr_quota.c
diff --git a/src/expr/fullcone.c b/src/expr/fullcone.c
new file mode 100644
index 0000000..b821331
--- /dev/null
+++ b/src/expr/fullcone.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libnftnl/expr.h>
+#include <libnftnl/rule.h>
+
+struct nftnl_expr_fullcone {
+	uint32_t type;
+};
+
+static int nftnl_expr_fullcone_set(struct nftnl_expr *e, uint16_t type, const void *data, uint32_t data_len)
+{
+	struct nftnl_expr_fullcone *fc = nftnl_expr_data(e);
+
+	switch(type) {
+	case NFTNL_EXPR_FULLCONE:
+		memcpy(&fc->type, data, sizeof(fc->type));
+		break;
+	default:
+		return -1;
+	}
+	return 0;
+}
+
+static const struct nftnl_expr_ops nftnl_expr_fullcone_ops = {
+	.type = NFTNL_EXPR_FULLCONE,
+	.name = "fullcone",
+	.alloc_size = sizeof(struct nftnl_expr_fullcone),
+	.set = nftnl_expr_fullcone_set,
+};
+
+static void __attribute__((constructor)) nftnl_expr_fullcone_init(void)
+{
+	nftnl_expr_register(&nftnl_expr_fullcone_ops);
+}
diff --git a/src/expr/expr_ops.c b/src/expr/expr_ops.c
index 77a2300..9272381 100644
--- a/src/expr/expr_ops.c
+++ b/src/expr/expr_ops.c
@@ -80,6 +80,7 @@ extern struct nftnl_expr_ops nftnl_expr_xor_ops;
 extern struct nftnl_expr_ops nftnl_expr_mp_ops;
 extern struct nftnl_expr_ops nftnl_expr_flow_offload_ops;
 extern struct nftnl_expr_ops nftnl_expr_objref_ops;
+extern struct nftnl_expr_ops nftnl_expr_fullcone_ops;

 static struct nftnl_expr_ops *expr_ops[] = {
 	&nftnl_expr_cmp_ops,
@@ -117,6 +118,7 @@ static struct nftnl_expr_ops *expr_ops[] = {
 	&nftnl_expr_xor_ops,
 	&nftnl_expr_mp_ops,
 	&nftnl_expr_flow_offload_ops,
+	&nftnl_expr_fullcone_ops,
 	&nftnl_expr_objref_ops,
 	&nftnl_expr_counter_ops,
 	&nftnl_expr_quota_ops,
--
2.45.1
