#!/bin/sh
# 99-custom 基础预设，适配OneCloud ImmortalWrt 24.10 dnsmasq-full
# 只做安全、基础配置，不强行修改dhcp@dnsmasq，避免时序报错

# 主机名
uci set system.@system[0].hostname='OneCloud'
# 时区
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# LAN 配置（默认 192.168.1.1，按需修改）
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.1.1'

# 关闭 ipv6 自动生成（可选，如果你不需要可以注释掉）
uci set network.lan.iface6='0'

# 系统默认语言
uci set luci.main.lang='zh_cn'

# 开启 ssh 密码登录（默认允许，按需改）
uci set dropbear.@dropbear[0].PasswordAuth='on'

# 提交配置
uci commit system
uci commit network
uci commit luci
uci commit dropbear

exit 0
