From 692bdcc207b3989ce39cbc74fc5c74aa15359ff0 Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Fri, 8 Apr 2022 23:52:11 +0800
Subject: [PATCH] libnftnl: add fullcone expression support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 include/libnftnl/expr.h          |  6 ++++++
 include/linux/netfilter/nf_tables.h | 16 ++++++++++++++++
 src/Makefile.am                  |  1 +
 src/expr/fullcone.c              | 168 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/expr_ops.c                   |  2 ++
 5 files changed, 193 insertions(+)
 create mode 100644 src/expr/fullcone.c

diff --git a/include/libnftnl/expr.h b/include/libnftnl/expr.h
index fba1210..0a3c6ca 100644
--- a/include/libnftnl/expr.h
+++ b/include/libnftnl/expr.h
@@ -271,6 +271,12 @@ enum {
        NFTNL_EXPR_META,
        NFTNL_EXPR_SOCKET,
        NFTNL_EXPR_OBJREF,
+       NFTNL_EXPR_FULLCONE,
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+int nftnl_expr_fullcone_set(struct nftnl_expr *e, uint16_t type, const void *data, uint32_t len);
+const void *nftnl_expr_fullcone_get(const struct nftnl_expr *e, uint16_t type, uint32_t *len);
 #ifdef __cplusplus
 }
 #endif
diff --git a/include/linux/netfilter/nf_tables.h b/include/linux/netfilter/nf_tables.h
index 2f8b442..312d107 100644
--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1620,6 +1620,22 @@ enum nft_ng_attr {
        NFT_NG_MAX
 };

+/**
+ * enum nft_fullcone_attributes - nftables fullcone nat expression
+ *
+ * @NFT_FULLCONE_REG_ADDR: source register for ip address
+ * @NFT_FULLCONE_DEV: netdevice name
+ */
+enum nft_fullcone_attributes {
+       NFT_FULLCONE_UNSPEC,
+       NFT_FULLCONE_REG_ADDR,
+       NFT_FULLCONE_DEV,
+       __NFT_FULLCONE_MAX,
+       NFT_FULLCONE_MAX = __NFT_FULLCONE_MAX -1
+};
+
 /**
  * enum nft_osf_attr - nftables osf expression
  */
diff --git a/src/Makefile.am b/src/Makefile.am
index 582700a..245213c 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -84,6 +84,7 @@ libnftnl_la_SOURCES = \
        expr/objref.c \
        expr/flow.c \
        expr/ct_helper.c \
+       expr/fullcone.c \
        set.c \
        table.c \
        chain.c \
diff --git a/src/expr/fullcone.c b/src/expr/fullcone.c
new file mode 100644
index 0000000..a031131
--- /dev/null
+++ b/src/expr/fullcone.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <libnftnl/expr.h>
+#include <libnftnl/rule.h>
+#include <linux/netfilter/nf_tables.h>
+
+struct nftnl_expr_fullcone {
+       char dev[IFNAMSIZ];
+       uint32_t reg_addr;
+};
+
+static int nftnl_expr_fullcone_set(struct nftnl_expr *e, uint16_t type,
+                                  const void *data, uint32_t len)
+{
+       struct nftnl_expr_fullcone *fc = nftnl_expr_data(e);
+
+       switch(type) {
+       case NFT_FULLCONE_REG_ADDR:
+               memcpy(&fc->reg_addr, data, sizeof(fc->reg_addr));
+               break;
+       case NFT_FULLCONE_DEV:
+               strncpy(fc->dev, data, IFNAMSIZ-1);
+               fc->dev[IFNAMSIZ-1] = '\0';
+               break;
+       default:
+               return -EINVAL;
+       }
+       return 0;
+}
+
+static const void *nftnl_expr_fullcone_get(const struct nftnl_expr *e, uint16_t type, uint32_t *len)
+{
+       struct nftnl_expr_fullcone *fc = nftnl_expr_data(e);
+
+       switch(type) {
+       case NFT_FULLCONE_REG_ADDR:
+               *len = sizeof(fc->reg_addr);
+               return &fc->reg_addr;
+       case NFT_FULLCONE_DEV:
+               *len = strlen(fc->dev)+1;
+               return fc->dev;
+       default:
+               return NULL;
+       }
+}
+
+static int nftnl_expr_fullcone_parse(struct nftnl_expr *e, struct nlattr *attr)
+{
+       struct nftnl_expr_fullcone *fc = nftnl_expr_data(e);
+       struct nlattr *tb[NFT_FULLCONE_MAX +1];
+
+       nla_parse(tb, NFT_FULLCONE_MAX, nla_data(attr), nla_len(attr), NULL);
+
+       if (tb[NFT_FULLCONE_REG_ADDR])
+               fc->reg_addr = nla_get_u32(tb[NFT_FULLCONE_REG_ADDR]);
+       if (tb[NFT_FULLCONE_DEV])
+               nla_strlcpy(fc->dev, tb[NFT_FULLCONE_DEV], IFNAMSIZ);
+       return 0;
+}
+
+static int nftnl_expr_fullcone_snprintf(char *buf, size_t size, uint32_t type, const struct nftnl_expr *e)
+{
+       struct nftnl_expr_fullcone *fc = nftnl_expr_data(e);
+
+       switch(type) {
+       case NFTNL_OUTPUT_DEFAULT:
+               return snprintf(buf, size, "fullcone %s reg %u", fc->dev, fc->reg_addr);
+       case NFTNL_OUTPUT_JSON:
+               return snprintf(buf, size, "\"fullcone\":{\"dev\":\"%s\",\"reg_addr\":%u}", fc->dev, fc->reg_addr);
+       default:
+               break;
+       }
+       return -1;
+}
+
+static void nftnl_expr_fullcone_free(struct nftnl_expr *e)
+{
+}
+
+struct nftnl_expr_ops nftnl_expr_fullcone_ops = {
+       .type = NFTNL_EXPR_FULLCONE,
+       .data_len = sizeof(struct nftnl_expr_fullcone),
+       .set = nftnl_expr_fullcone_set,
+       .get = nftnl_expr_fullcone_get,
+       .parse = nftnl_expr_fullcone_parse,
+       .snprintf = nftnl_expr_fullcone_snprintf,
+       .free = nftnl_expr_fullcone_free,
+};
+
+void __attribute__((constructor)) nftnl_expr_fullcone_init(void)
+{
+       nftnl_expr_register(&nftnl_expr_fullcone_ops);
+}
diff --git a/src/expr_ops.c b/src/expr_ops.c
index c82437c..9122721 100644
--- a/src/expr_ops.c
+++ b/src/expr_ops.c
@@ -46,6 +46,8 @@ extern struct nftnl_expr_ops nftnl_expr_objref_ops;
 extern struct nftnl_expr_ops nftnl_expr_flow_ops;
 extern struct nftnl_expr_ops nftnl_expr_ct_helper_ops;
+extern struct nftnl_expr_ops nftnl_expr_fullcone_ops;
+
 struct nftnl_expr_ops *expr_ops[] = {
        &nftnl_expr_immediate_ops,
        &nftnl_expr_bitwise_ops,
        &nftnl_expr_cmp_ops,
        &nftnl_expr_payload_ops,
        &nftnl_expr_bitmask_ops,
        &nftnl_expr_hash_ops,
        &nftnl_expr_ct_ops,
        &nftnl_expr_counter_ops,
        &nftnl_expr_meta_ops,
        &nftnl_expr_limit_ops,
        &nftnl_expr_dup_ops,
        &nftnl_expr_fwd_ops,
        &nftnl_expr_log_ops,
        &nftnl_expr_reject_ops,
        &nftnl_expr_queue_ops,
        &nftnl_expr_set_ops,
        &nftnl_expr_map_ops,
        &nftnl_expr_objref_ops,
        &nftnl_expr_flow_ops,
        &nftnl_expr_ct_helper_ops,
+       &nftnl_expr_fullcone_ops,
        NULL,
 };
