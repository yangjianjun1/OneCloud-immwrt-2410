From e5660fb4ab44d902810c7f6681789f017556498a Mon Sep 17 00:00:00 2001
From: Syrone Wong <wong.syrone@gmail.com>
Date: Sat, 9 Apr 2022 00:38:51 +0800
Subject: [PATCH] nftables: add fullcone expression support

Signed-off-by: Syrone Wong <wong.syrone@gmail.com>
---
 include/linux/netfilter/nf_tables.h | 16 ++++++++++
 include/statement.h                 |  1 +
 src/netlink_delinearize.c           | 48 +++++++++++++++++++++++++++++
 src/netlink_linearize.c             |  7 +++++
 src/parser_bison.y                  | 28 +++++++++++++++--
 src/scanner.l                       |  1 +
 src/statement.c                     |  1 +
 7 files changed, 100 insertions(+), 2 deletions(-)

diff --git a/include/linux/netfilter/nf_tables.h b/include/linux/netfilter/nf_tables.h
index c62e6ac5..6ca4cd53 100644
--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1620,6 +1620,22 @@ enum nft_ng_attr {
        NFT_NG_MAX
 };

+/**
+ * enum nft_fullcone_attributes - nftables fullcone nat expression
+ *
+ * @NFT_FULLCONE_REG_ADDR: source register for ip address
+ * @NFT_FULLCONE_DEV: netdevice name
+ */
+enum nft_fullcone_attributes {
+       NFT_FULLCONE_UNSPEC,
+       NFT_FULLCONE_REG_ADDR,
+       NFT_FULLCONE_DEV,
+       __NFT_FULLCONE_MAX,
+       NFT_FULLCONE_MAX = __NFT_FULLCONE_MAX -1,
+};
+
 /**
  * enum nft_osf_attr - nftables osf expression
  */
diff --git a/include/statement.h b/include/statement.h
index 8422300..3392236 100644
--- a/include/statement.h
+++ b/include/statement.h
@@ -175,6 +175,7 @@ enum stmt_type {
        STMT_OBJREF,
        STMT_FLOW,
        STMT_CT_HELPER,
+       STMT_FULLCONE,
        STMT_OSF,
        STMT_TUNNEL,
        STMT_IMMEDIATE,
diff --git a/src/netlink_delinearize.c b/src/netlink_delinearize.c
index 371c32c..7532c34 100644
--- a/src/netlink_delinearize.c
+++ b/src/netlink_delinearize.c
@@ -2047,6 +2047,54 @@ static int nftnl_stmt_osf_parse(struct netlink_delinearize *d,
        return 0;
 }

+static int nftnl_stmt_fullcone_parse(struct netlink_delinearize *d,
+                                   struct nlattr *attr)
+{
+       struct nlattr *tb[NFT_FULLCONE_MAX + 1];
+       struct stmt *stmt;
+       char *dev = NULL;
+       uint32_t reg_addr = 0;
+
+       nla_parse(tb, NFT_FULLCONE_MAX, nla_data(attr), nla_len(attr), NULL);
+
+       if (tb[NFT_FULLCONE_REG_ADDR])
+               reg_addr = nla_get_u32(tb[NFT_FULLCONE_REG_ADDR]);
+       if (tb[NFT_FULLCONE_DEV])
+               dev = nla_strdup(tb[NFT_FULLCONE_DEV]);
+
+       stmt = stmt_alloc(STMT_FULLCONE);
+       stmt->fullcone.reg_addr = reg_addr;
+       stmt->fullcone.dev = dev;
+       stmt->location = d->location;
+       list_add_tail(&stmt->list, &d->stmts);
+
+       return 0;
+}
+
 static int nftnl_stmt_parse(struct netlink_delinearize *d, struct nlattr *attr)
 {
        int type = nla_type(attr);

        switch (type) {
        case NFTNL_EXPR_OSF:
                return nftnl_stmt_osf_parse(d, attr);
+       case NFTNL_EXPR_FULLCONE:
+               return nftnl_stmt_fullcone_parse(d, attr);
        default:
                return stmt_expr_parse(d, attr);
        }
 }
diff --git a/src/netlink_linearize.c b/src/netlink_linearize.c
index 1419982..3412917 100644
--- a/src/netlink_linearize.c
+++ b/src/netlink_linearize.c
@@ -1878,6 +1878,13 @@ static int nftnl_stmt_osf_build(struct netlink_linearize *l,
        return 0;
 }

+static int nftnl_stmt_fullcone_build(struct netlink_linearize *l, struct stmt *stmt)
+{
+       nftnl_expr_begin(l->expr, NFTNL_EXPR_FULLCONE);
+       nftnl_expr_set_u32(l->expr, NFT_FULLCONE_REG_ADDR, stmt->fullcone.reg_addr);
+       if (stmt->fullcone.dev)
+               nftnl_expr_set_str(l->expr, NFT_FULLCONE_DEV, stmt->fullcone.dev);
+       return nftnl_expr_end(l);
+}
+
 static int nftnl_stmt_build(struct netlink_linearize *l, struct stmt *stmt)
 {
        switch (stmt->type) {
        case STMT_OSF:
                return nftnl_stmt_osf_build(l, stmt);
+       case STMT_FULLCONE:
+               return nftnl_stmt_fullcone_build(l, stmt);
        default:
                return stmt_expr_build(l, stmt);
        }
 }
diff --git a/src/parser_bison.y b/src/parser_bison.y
index 873212a..b42222a 100644
--- a/src/parser_bison.y
+++ b/src/parser_bison.y
@@ -177,7 +177,7 @@ stmt:
 |       stmt_objref
 |       stmt_flow
 |       stmt_ct_helper
-|       stmt_osf
+|       stmt_osf | stmt_fullcone
 |       stmt_tunnel
 |       stmt_immediate
 |       stmt_counter
@@ -1476,6 +1476,32 @@ stmt_ct_helper:
        }
 ;

+stmt_fullcone:
+       FULLCONE dev_spec
+       {
+               $$ = stmt_alloc(STMT_FULLCONE);
+               $$->fullcone.dev = $2;
+               $$->fullcone.reg_addr = NFT_REG_1;
+       }
+       | FULLCONE dev_spec ip saddr expr
+       {
+               $$ = stmt_alloc(STMT_FULLCONE);
+               $$->fullcone.dev = $2;
+               $$->fullcone.reg_addr = $4->reg;
+               expr_free($4);
+       }
+;
+
 stmt_osf:
        OSF osf_opts
        {
@@ -2244,7 +2270,7 @@ primary_expr:
        |   EXPR_SOCKET
        |   EXPR_OBJREF
        |   EXPR_FLOW
-       |   EXPR_OSF
+       |   EXPR_OSF | EXPR_FULLCONE
        |   EXPR_TUNNEL
        |   EXPR_IMMEDIATE
        |   EXPR_COUNTER
diff --git a/src/scanner.l b/src/scanner.l
index 1649440..452935c 100644
--- a/src/scanner.l
+++ b/src/scanner.l
@@ -228,6 +228,7 @@
%token EXPR_OBJREF "objref"
%token EXPR_FLOW "flow"
%token EXPR_OSF "osf"
+%token EXPR_FULLCONE "fullconenat"
%token EXPR_TUNNEL "tunnel"
%token EXPR_IMMEDIATE "immediate"
%token EXPR_COUNTER "counter"

@@ -1270,6 +1271,7 @@ objref          { return EXPR_OBJREF; }
flow            { return EXPR_FLOW; }
osf             { return EXPR_OSF; }
+tunnel          { return EXPR_TUNNEL; }
+fullconenat    { return EXPR_FULLCONE; }
 tunnel          { return EXPR_TUNNEL; }
 immediate      { return EXPR_IMMEDIATE; }
 counter        { return EXPR_COUNTER; }
diff --git a/src/statement.c b/src/statement.c
index 3423407..4844218 100644
--- a/src/statement.c
+++ b/src/statement.c
@@ -484,6 +484,7 @@ void stmt_free(struct stmt *stmt)
        case STMT_CT_HELPER:
                break;
        case STMT_OSF:
+       case STMT_FULLCONE:
                free(stmt->fullcone.dev);
                break;
        case STMT_TUNNEL:
                free(stmt->tunnel.expression);
--
2.35.3
